# Keys: see docs/api-keys.md in the skill repo for getting each one.
OPENAI_API_KEY=

# Slide images through Gemini instead of OpenAI (needs billing on the key's project)
# GEMINI_API_KEY=
# IMAGE_PROVIDER=gemini

# GIF candidates (scripts/find-gifs.mjs, npm run gifs:search). A free key: sign in at
# https://developers.giphy.com/dashboard/, create an app, choose "API" (not "SDK"), and copy
# its key. Only the search needs it; downloading a picked GIF and the memes need no key.
GIPHY_API_KEY=

# Everything below is optional; the scripts' defaults are shown.
# Providers retire models regularly: check https://platform.openai.com/docs/deprecations
# (and the Gemini model list, see docs/api-keys.md) before a new deck and point these at the replacements.

# Slide images (scripts/generate-slide-images.mjs)
# OPENAI_IMAGE_CONTEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_STYLE=flat 3D cartoon, warm light
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# GIF search rating: g, pg, pg-13 or r
# GIPHY_RATING=pg-13

# Rehearsal audio (scripts/generate-speaker-notes-audio.mjs)
# OPENAI_TTS_MODEL=gpt-audio-1.5
# OPENAI_TTS_VOICE=cedar
# OPENAI_TTS_VOICES=erik=cedar,dana=marin
# OPENAI_TTS_TALK=tech talk
# OPENAI_TTS_PACE_WPM=112

# Verifying the audio by transcribing it back (references/speaker-notes.md)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
