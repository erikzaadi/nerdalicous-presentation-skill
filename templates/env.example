OPENAI_API_KEY=

# Everything below is optional; the scripts' defaults are shown.
# OpenAI retires models regularly: check https://platform.openai.com/docs/deprecations
# before a new deck and point these at the replacements.

# Slide images (scripts/generate-slide-images.mjs)
# OPENAI_IMAGE_CONTEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_STYLE=flat 3D cartoon, warm light

# Rehearsal audio (scripts/generate-speaker-notes-audio.mjs)
# OPENAI_TTS_MODEL=gpt-audio-1.5
# OPENAI_TTS_VOICE=cedar
# OPENAI_TTS_VOICES=erik=cedar,dana=marin
# OPENAI_TTS_TALK=tech talk
# OPENAI_TTS_PACE_WPM=112

# Verifying the audio by transcribing it back (references/speaker-notes.md)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
